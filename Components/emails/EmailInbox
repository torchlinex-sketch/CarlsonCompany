import React from "react";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Star, StarOff } from "lucide-react";
import { format } from "date-fns";
import { motion } from "framer-motion";

export default function EmailInbox({ emails, selectedEmail, onSelectEmail, onToggleStar }) {
  return (
    <Card className="shadow-xl border-0 overflow-hidden">
      <div className="divide-y divide-slate-100">
        {emails.length === 0 ? (
          <div className="text-center py-12 text-slate-500">
            <p>No emails yet</p>
          </div>
        ) : (
          emails.map((email) => (
            <motion.div
              key={email.id}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              className={`p-4 cursor-pointer transition-all hover:bg-slate-50 ${
                selectedEmail?.id === email.id ? 'bg-blue-50' : ''
              } ${!email.is_read ? 'bg-blue-50/30' : ''}`}
              onClick={() => onSelectEmail(email)}
            >
              <div className="flex items-start gap-3">
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    onToggleStar(email);
                  }}
                  className="mt-1"
                >
                  {email.is_starred ? (
                    <Star className="w-5 h-5 text-amber-500 fill-amber-500" />
                  ) : (
                    <StarOff className="w-5 h-5 text-slate-300 hover:text-amber-500" />
                  )}
                </button>

                <div className="flex-1 min-w-0">
                  <div className="flex items-start justify-between gap-2 mb-1">
                    <p className={`font-medium text-slate-900 truncate ${!email.is_read ? 'font-bold' : ''}`}>
                      {email.from_name || email.from_email}
                    </p>
                    <span className="text-xs text-slate-500 whitespace-nowrap">
                      {format(new Date(email.received_date), 'MMM d, h:mm a')}
                    </span>
                  </div>

                  <p className={`text-sm truncate mb-1 ${!email.is_read ? 'font-semibold text-slate-900' : 'text-slate-700'}`}>
                    {email.subject}
                  </p>

                  <p className="text-sm text-slate-500 truncate">
                    {email.body.substring(0, 100)}...
                  </p>

                  {email.labels && email.labels.length > 0 && (
                    <div className="flex gap-1 mt-2">
                      {email.labels.map((label, idx) => (
                        <Badge key={idx} variant="outline" className="text-xs">
                          {label}
                        </Badge>
                      ))}
                    </div>
                  )}
                </div>

                {!email.is_read && (
                  <div className="w-2 h-2 rounded-full bg-blue-600 mt-2" />
                )}
              </div>
            </motion.div>
 
